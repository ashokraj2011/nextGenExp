{
  "name": "@sfield/cli",
  "version": "0.1.0",
  "description": "Standalone CLI for the sfield Agent SDK: init, validate, eval, lock status/approve, inspect, doctor, and mcp serve.",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.13"
  },
  "files": [
    "dist"
  ],
  "bin": {
    "sfield": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "keywords": [
    "sfield",
    "cli",
    "mcp",
    "ai-agents",
    "governance"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ashokraj2011/nextGenExp.git",
    "directory": "vendor/sfield/packages/cli"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@sfield/core": "0.1.0",
    "@sfield/store-sqlite": "0.1.0",
    "@sfield/testing": "0.1.0"
  }
}
