{
  "name": "@sfield/preset-local",
  "version": "0.1.0",
  "description": "Zero-boilerplate durable local development preset (SQLite + filesystem artifacts) for @sfield/core.",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.13"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "keywords": [
    "sfield",
    "preset",
    "sqlite",
    "ai-agents"
  ],
  "repository": {
    "type": "git",
