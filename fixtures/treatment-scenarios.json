{
  "fixtureVersion": "pzn-ts-routed-v8",
  "base": {
    "balance": ["balance_education", "balance_available_definition", "balance_current_definition", "promotion_general", "balance_metric_template"],
    "portsum": ["portfolio_explanation", "portfolio_cash_investing"],
    "learning": ["retirement_learning", "beneficiary_update"],
    "goals": ["home_down_payment_progress"],
    "address-update": ["address_update_guide", "fund_account"],
    "app-home": ["transfer_checklist", "transfer_learning", "promotion_general"],
    "next-step": ["fund_account"],
    "pending-actions": ["beneficiary_update", "fund_account"]
  },
  "actionRules": [
    {
      "contextId": "address-update",
      "name": "Mailing address update requested",
      "condition": { "kind": "always" },
      "action": { "kind": "action", "id": "account.address.prepare", "version": "1.0.0" }
    }
  ],
  "defaultCcreRules": [
    {
      "contextId": "portsum",
      "contentId": "portfolio_cash_investing",
      "name": "Cash above $10,000",
      "condition": {
        "kind": "attribute",
        "glossaryVersion": "pzn-ccre-mock-v1",
        "namespaceId": "portfolio",
        "attributeId": "cash_usd",
        "operator": "gt",
        "value": 10000
      }
    },
    {
      "contextId": "learning",
      "contentId": "beneficiary_update",
      "name": "Beneficiary details are missing",
      "condition": {
        "kind": "attribute",
        "glossaryVersion": "pzn-ccre-mock-v1",
        "namespaceId": "customer",
        "attributeId": "beneficiary_status",
        "operator": "eq",
        "value": "missing"
      }
    },
    {
      "contextId": "address-update",
      "contentId": "fund_account",
      "workflowRequiresContentIds": ["address_update_guide"],
      "name": "Account is unfunded",
      "workflow": { "kind": "workflow", "id": "account.funding.preview", "version": "1.0.0" },
      "condition": {
        "kind": "attribute",
        "glossaryVersion": "pzn-ccre-mock-v1",
        "namespaceId": "account",
        "attributeId": "funding_status",
        "operator": "eq",
        "value": "unfunded"
      }
    },
    {
      "contextId": "next-step",
      "contentId": "fund_account",
      "name": "Account is unfunded",
      "workflow": { "kind": "workflow", "id": "account.funding.preview", "version": "1.0.0" },
      "condition": {
        "kind": "attribute",
        "glossaryVersion": "pzn-ccre-mock-v1",
        "namespaceId": "account",
        "attributeId": "funding_status",
        "operator": "eq",
        "value": "unfunded"
      }
    },
    {
      "contextId": "pending-actions",
      "contentId": "beneficiary_update",
      "name": "Beneficiary details are missing",
      "condition": {
        "kind": "attribute",
        "glossaryVersion": "pzn-ccre-mock-v1",
        "namespaceId": "customer",
        "attributeId": "beneficiary_status",
        "operator": "eq",
        "value": "missing"
      }
    },
    {
      "contextId": "pending-actions",
      "contentId": "fund_account",
      "name": "Account is unfunded",
      "workflow": { "kind": "workflow", "id": "account.funding.preview", "version": "1.0.0" },
      "condition": {
        "kind": "attribute",
        "glossaryVersion": "pzn-ccre-mock-v1",
        "namespaceId": "account",
        "attributeId": "funding_status",
        "operator": "eq",
        "value": "unfunded"
      }
    }
  ],
  "scenarios": [
    { "scenarioId": "normal", "label": "Standard rules", "rules": [] },
    { "scenarioId": "conflicting-propensity", "label": "High score for another topic", "rules": [] },
    { "scenarioId": "missing-propensity", "label": "Missing relevance score", "rules": [] },
    { "scenarioId": "propensity-unavailable", "label": "Relevance scores unavailable", "rules": [] },
    { "scenarioId": "catalog-unavailable", "label": "Topic list unavailable", "rules": [] },
    {
      "scenarioId": "relevant-blocked", "label": "Rule filters out matching content",
      "rules": [
        { "context": "app-home", "fromTurn": 1, "eligible": ["transfer_learning", "transfer_checklist"], "rejections": [{ "contentId": "promotion_blocked", "stage": "simulated_ccre", "reasonCode": "RULE_FALSE" }] }
      ]
    },
    {
      "scenarioId": "empty", "label": "No matching content",
      "rules": [{ "context": "*", "fromTurn": 1, "eligible": [] }]
    },
    {
      "scenarioId": "ts-unavailable", "label": "Treatment Selector times out",
      "rules": [{ "context": "*", "fromTurn": 1, "error": "TS_TIMEOUT" }]
    },
    {
      "scenarioId": "cross-turn-change", "label": "Matching content changes by message",
      "rules": [
        { "context": "app-home", "fromTurn": 1, "eligible": ["transfer_learning", "transfer_checklist"] },
        { "context": "app-home", "fromTurn": 2, "eligible": ["portfolio_explanation"] }
      ]
    },
    {
      "scenarioId": "catalog-resolution", "label": "Missing or withdrawn content",
      "rules": [
        { "context": "balance", "fromTurn": 1, "eligible": ["balance_education", "catalog_missing_item", "withdrawn_education"] },
        { "context": "balance", "fromTurn": 2, "eligible": ["catalog_missing_item", "withdrawn_education"] }
      ]
    }
  ]
}
