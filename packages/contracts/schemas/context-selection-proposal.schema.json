{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "context-selection-proposal",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "string",
      "enum": [
        "1.1"
      ]
    },
    "catalogSnapshotId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "catalogVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "status": {
      "type": "string",
      "enum": [
        "selected",
        "clarify",
        "no_match",
        "create_rule"
      ]
    },
    "intentId": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "clarificationQuestion": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 400
    }
  },
  "required": [
    "schemaVersion",
    "catalogSnapshotId",
    "catalogVersion",
    "status",
    "intentId",
    "summary",
    "clarificationQuestion"
  ]
}
