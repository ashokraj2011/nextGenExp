# Chat Completions prefix, including /v1 only if required by your gateway.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
# Optional HTTP headers. Object and array values are serialized as JSON.
# LLM_GATEWAY_HEADERS_JSON='{"X-Client-Id":"pzn-lab","X-Gateway-Context":{"environment":"demo"}}'
# Optional additional JSON fields in the Chat Completions request.
# LLM_GATEWAY_BODY_JSON='{"metadata":{"application":"pzn-lab"}}'
# Set after confirming limits and quirks with the gateway.
LLM_CONTEXT_WINDOW=16384
LLM_MAX_OUTPUT_TOKENS=1500
# LLM_QUIRKS=no_stream_usage
# PZN_SELECTION_MODE=semantic_rerank
# PZN_PORT=4173
# PZN_DATA_DIR=.pzn-data
