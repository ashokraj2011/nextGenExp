# Model provider for npm start and npm run dev: gateway, openai, or copilot_acp.
LLM_PROVIDER=gateway
# For npm run start:openai, set OPENAI_API_KEY in the server environment or .env.openai.
# For copilot_acp, install and sign in to GitHub Copilot CLI. Leave LLM_MODEL empty for auto.
# COPILOT_ACP_COMMAND=/path/to/copilot
# For gateway, use the Chat Completions prefix, including /v1 only if required.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
# Optional HTTP headers. Object and array values are serialized as JSON.
# LLM_GATEWAY_HEADERS_JSON='{"X-Client-Id":"pzn-lab","X-Gateway-Context":{"environment":"demo"}}'
# Optional additional JSON fields in the Chat Completions request.
# LLM_GATEWAY_BODY_JSON='{"metadata":{"application":"pzn-lab"}}'
# Set after confirming limits and quirks with the gateway.
LLM_CONTEXT_WINDOW=16384
LLM_MAX_OUTPUT_TOKENS=1500
# LLM_QUIRKS=no_stream_usage
# The model gateway can also be configured, tested and activated in Administration → Model gateway (/admin/gateway).
# A configuration activated there is saved in the data directory and overrides the LLM_* variables above.
# PZN_SELECTION_MODE=semantic_rerank
# PZN_PORT=4173
# PZN_DATA_DIR=.pzn-data
# PZN_OPERATORS_JSON optionally maps operator usernames to passwords (12+ characters each).
# If omitted, the server writes operator-credentials.json in its active data directory.
# PZN_OPERATOR_AUTH=off skips the sign-in prompt for local demos (admin actions are attributed to local-operator).
# Refused under NODE_ENV=production. Leave it unset to require sign-in.

# Optional lower limits for goal runs. Keys include modelCalls, toolCalls, planRevisions, contexts, parallelReads, activeSeconds, clarifications.
# PZN_AXE_BUDGET_JSON='{"toolCalls":12,"activeSeconds":45}'
