{
  "name": "pzn-intent-experience",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13",
    "npm": ">=10"
  },
  "scripts": {
    "bootstrap": "npm ci && npm run build:sfield",
    "dev": "npm run build:sfield && node --env-file-if-exists=.env --import tsx apps/server/main.ts --dev",
    "start": "node --env-file-if-exists=.env --import tsx apps/server/main.ts",
    "check": "npm run build:sfield && tsc --noEmit",
    "build": "npm run check && vite build",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:browser": "node --import tsx tests/browser.ts",
    "test:preview": "node --import tsx tests/test-preview.ts",
    "eval:live": "node --env-file-if-exists=.env --import tsx tests/evaluate-live.ts",
    "build:sfield": "node scripts/build-sfield.mjs",
    "pretest": "npm run build:sfield"
  },
  "dependencies": {
    "@a2ui/react": "0.15.0",
    "@a2ui/web_core": "0.15.0",
    "@assistant-ui/react": "0.15.37",
    "@fontsource-variable/inter": "5.3.0",
    "@sfield/core": "0.1.0",
    "@sfield/store-sqlite": "0.1.0",
    "ajv": "8.20.0",
    "lucide-react": "1.77.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsx": "4.23.15",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.20.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "playwright": "1.65.1",
    "typescript": "5.9.3",
    "vite": "8.3.8"
  },
  "workspaces": [
    "vendor/sfield/packages/*"
  ],
  "overrides": {
    "@a2ui/markdown-it@0.2.2": {
      "@a2ui/web_core": "$@a2ui/web_core"
    }
  }
}
