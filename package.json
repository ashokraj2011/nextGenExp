{
  "name": "pzn-intent-experience",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13",
    "npm": ">=10"
  },
  "scripts": {
    "bootstrap": "npm ci && npm run build:sfield",
    "dev": "npm run build:sfield && node --env-file-if-exists=.env --import tsx apps/server/main.ts --dev",
    "start": "node --env-file-if-exists=.env --import tsx apps/server/main.ts",
    "start:openai": "node --env-file-if-exists=.env.openai --import tsx apps/server/main.ts --openai",
    "check": "npm run build:sfield && tsc --noEmit",
    "build": "npm run check && vite build",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:browser": "node --import tsx tests/browser.ts && node --import tsx tests/agentic-browser.ts && node --import tsx tests/ui-builder-browser.ts",
    "preview": "node --env-file-if-exists=.env --import tsx apps/server/main.ts --preview",
    "chat:harness": "npm run build:sfield && node --import tsx apps/harness/chat.ts",
    "mcp:stdio": "npm run build:sfield && node --env-file-if-exists=.env --import tsx apps/server/mcp-stdio.ts",
    "sfield": "npm run build:sfield && node vendor/sfield/packages/cli/dist/bin.js",
    "eval:live": "node --env-file-if-exists=.env --import tsx tests/evaluate-live.ts",
    "eval:openai": "node --env-file-if-exists=.env.openai --import tsx tests/evaluate-live.ts --openai --smoke",
    "build:sfield": "tsc -b vendor/sfield/packages/preset-memory vendor/sfield/packages/preset-local vendor/sfield/packages/store-sqlite vendor/sfield/packages/telemetry-otel vendor/sfield/packages/store-postgres vendor/sfield/packages/cli",
    "pretest": "npm run build:sfield",
    "eval:agentic": "node --env-file-if-exists=.env --import tsx tests/evaluate-agentic.ts"
  },
  "dependencies": {
    "@a2ui/react": "0.15.0",
    "@a2ui/web_core": "0.15.0",
    "@assistant-ui/react": "0.15.37",
    "@fontsource-variable/inter": "5.3.0",
    "@sfield/core": "0.1.0",
    "@sfield/store-sqlite": "0.1.0",
    "ajv": "8.20.0",
    "lucide-react": "1.74.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsx": "4.23.15",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/markdown-it": "14.2.0",
    "@types/node": "22.20.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "markdown-it": "14.3.3",
    "playwright": "1.65.1",
    "typescript": "5.9.3",
    "vite": "8.3.8"
  },
  "workspaces": [
    "vendor/sfield/packages/*"
  ],
  "overrides": {
    "@a2ui/markdown-it@0.2.2": {
      "@a2ui/web_core": "$@a2ui/web_core"
    },
    "@babel/runtime": "7.29.14"
  }
}
